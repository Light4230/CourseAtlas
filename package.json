{
  "name": "courseatlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first, PDF-grounded multi-course study workbench.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "samples": "node scripts/make-samples.mjs",
    "mock:llm": "node scripts/mock-llm.mjs"
  },
  "dependencies": {
    "express": "4.21.2",
    "i18next": "25.3.2",
    "katex": "^0.19.1",
    "lucide-react": "0.468.0",
    "minisearch": "7.1.2",
    "multer": "2.0.2",
    "pdfjs-dist": "3.11.174",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-i18next": "15.6.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/multer": "1.4.12",
    "@types/node": "24.1.0",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "concurrently": "9.2.0",
    "pdf-lib": "1.17.1",
    "playwright-core": "1.54.1",
    "postcss": "8.5.6",
    "supertest": "7.1.4",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.3",
    "typescript": "5.9.2",
    "vite": "7.0.6",
    "vitest": "3.2.4"
  }
}
