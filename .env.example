# CourseAtlas server configuration
# Copy to .env and fill values locally. NEVER commit .env.

PORT=3001

# Optional. If omitted, the server generates .secrets/model-key on first use.
# Use a long random value in production. Do not commit a real secret.
MODEL_KEY_SECRET=

# Optional web search. Leave blank to show "Search not configured" in the UI.
# The app currently supports Tavily's search API.
TAVILY_API_KEY=

# Optional: allow http://localhost model endpoints for local development tests.
# Keep false for normal use; provider base URLs must then use HTTPS.
ALLOW_LOCAL_MODELS=false
